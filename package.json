{
  "scripts": {
    "prepare": "husky"
  },
  "devDependencies": {
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
    "husky": "^9.1.7"
  },
  "lint-staged": {
    "backend/**/*.{js,jsx,ts,tsx,json,css,scss,md}": [
      "sh -c 'cd backend && bun run prettier . --write'",
      "sh -c 'cd backend && bun run lint'"
    ],
    "frontend/**/*.{js,jsx,ts,tsx,json,css,scss,md}": [
      "sh -c 'cd frontend && bun run prettier . --write'"
    ]
  }
}
